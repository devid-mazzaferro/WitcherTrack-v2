<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- One version for the whole project, shared with the in-game reporter so a report
         and the build that reads it can never be from different releases. 1.0 once every
         diagram carried the content pack it belongs to, which was the last piece of data
         the per-pack modes were missing. -->
    <Version>1.2.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The whole project deliberately has ZERO third-party dependencies:
         everything ships in a single self-contained executable that anyone
         can audit without chasing transitive packages. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
